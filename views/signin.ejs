<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sign In</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="page">

        <div class="card">

            <h2>Sign In</h2>

            <form action="/dashboard" method="post" class="signin-form">

                <input
                    name="name"
                    type="text"
                    placeholder="Name"
                    class="input-field"
                >

                <input
                    name="email"
                    type="email"
                    placeholder="Email"
                    class="input-field"
                >

                <p class="footer-text">
                    Don't have an account?
                    <a href="/signup">Sign Up</a>
                </p>

                <button type="submit" class="button">
                    Sign In
                </button>

            </form>

        </div>

    </div>

</body>
</html>